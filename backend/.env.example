# Application Settings
APP_NAME=EventPrice Intelligence API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Server Settings
HOST=127.0.0.1
PORT=8000

# CORS Configuration (comma-separated origins or JSON array)
CORS_ORIGINS=["http://localhost:5173"]

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./eventprice.db
# Future PostgreSQL example (using modern psycopg v3 driver):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/eventprice_db
DB_ECHO_LOG=False

# Security & Secrets (Always set a unique secret in your real .env, never commit real secrets)
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32chars

# AI & Gemini Configuration (Server-side only; never committed or exposed to clients)
AI_ENABLED=True
AI_PROVIDER=gemini
# Obtain your Gemini API key from https://aistudio.google.com/app/apikey
# In production, load this key via a secure secrets manager (e.g. GCP Secret Manager, Vault)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=10.0

# External Data Providers Configuration (Phase 10: Backend only, never exposed to browser)
OPENWEATHER_ENABLED=True
# Obtain free API key from https://openweathermap.org/api
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_TIMEOUT_SECONDS=10.0

OVERPASS_ENABLED=True
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=25.0

NOMINATIM_ENABLED=True
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_TIMEOUT_SECONDS=10.0
NOMINATIM_USER_AGENT=EventPriceIntelligence/1.0 (contact@eventprice.local)

